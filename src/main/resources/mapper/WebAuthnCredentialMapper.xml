<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.WebAuthnCredentialMapper">
    <resultMap id="WebAuthnCredentialResult" type="com.example.demo.model.WebAuthnCredential">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="credentialId" column="credential_id" jdbcType="VARBINARY"/>
        <result property="publicKeyCose" column="public_key_cose" jdbcType="VARBINARY"/>
        <result property="signCount" column="sign_count"/>
        <result property="transports" column="transports"/>
        <result property="attestationType" column="attestation_type"/>
        <result property="aaguid" column="aaguid"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
</mapper>

